# ---------------------------------------------------------------------------
# Copy to .env.local and fill in with values from your own Neon project.
# .env.local is git-ignored. Never commit real values.
# ---------------------------------------------------------------------------

# PUBLIC (safe to expose to the browser) ------------------------------------
# These are shipped to the client on purpose. They are not secrets: every row
# they can reach is protected by Row Level Security in Postgres.
# Neon Console -> Auth -> Configuration -> Auth URL
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example.neonauth.REGION.aws.neon.tech/neondb/auth
# Neon Console -> Postgres database -> Data API -> API URL
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example.apirest.REGION.aws.neon.tech/neondb/rest/v1

# SERVER-ONLY (never prefix these with NEXT_PUBLIC_) ------------------------
# The app itself does not use DATABASE_URL at runtime: the browser talks to the
# Data API over HTTPS and RLS enforces ownership. It is only needed to apply
# migrations in db/migrations. It bypasses RLS, so it must never reach the client.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Two accounts used by the automated Row Level Security isolation test.
# Optional: the RLS test skips itself when these are absent.
TEST_USER_A_EMAIL=user-a@example.com
TEST_USER_A_PASSWORD=replace-me
TEST_USER_B_EMAIL=user-b@example.com
TEST_USER_B_PASSWORD=replace-me
