# @neondatabase/neon-js (beta) pulls in Better Auth packages with a peer-dependency
# conflict between better-call 1.3.7 and 1.4.0. npm 11 treats this as a hard error.
# The conflict is internal to the SDK's own dependency graph and does not affect the
# APIs this app uses, so we fall back to the npm 6 resolution behaviour.
legacy-peer-deps=true
